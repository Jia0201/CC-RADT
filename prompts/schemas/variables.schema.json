{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-teams.local/schemas/variables.schema.json",
  "title": "AI-Teams Task Prompt Variables",
  "type": "object",
  "required": [
    "task_id",
    "workflow_id",
    "agent_id",
    "objective",
    "scope",
    "forbidden_scope",
    "context_refs",
    "instructions",
    "acceptance_criteria",
    "verification",
    "handoff_target",
    "output_contract"
  ],
  "properties": {
    "task_id": {"type": "string", "minLength": 1},
    "workflow_id": {"type": "string", "pattern": "^WF-(0[1-9]|1[0-2])$"},
    "agent_id": {
      "enum": [
        "lead", "pd", "plan-pm", "dev-frontend-web", "dev-frontend-miniapp",
        "dev-backend-systems", "dev-backend-service", "qa", "memory", "doc",
        "role", "security-reviewer"
      ]
    },
    "objective": {"type": "string", "minLength": 1},
    "scope": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "forbidden_scope": {"type": "array", "items": {"type": "string"}},
    "context_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "purpose", "trust"],
        "properties": {
          "path": {"type": "string"},
          "purpose": {"type": "string"},
          "trust": {"enum": ["trusted-rule", "trusted-project-fact", "task-input", "untrusted-external"]}
        },
        "additionalProperties": false
      }
    },
    "instructions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "verification": {"type": "array", "items": {"type": "string"}},
    "handoff_target": {"type": "string", "minLength": 1},
    "output_contract": {"type": "string", "minLength": 1},
    "risk_level": {"enum": ["low", "medium", "high"]},
    "lock_refs": {"type": "array", "items": {"type": "string"}},
    "attempt": {"type": "integer", "minimum": 0, "maximum": 1}
  },
  "additionalProperties": false
}

