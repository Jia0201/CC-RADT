{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-teams.local/schemas/eval-case.schema.json",
  "title": "AI-Teams Prompt Evaluation Cases",
  "type": "object",
  "required": ["schemaVersion", "agent", "promptVersion", "cases"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "agent": {"type": "string"},
    "promptVersion": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "cases": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "type", "input", "expected"],
        "properties": {
          "id": {"type": "string"},
          "type": {"enum": ["positive", "negative", "security", "output-contract"]},
          "input": {"type": "object"},
          "expected": {
            "type": "object",
            "required": ["must", "mustNot"],
            "properties": {
              "must": {"type": "array", "items": {"type": "string"}},
              "mustNot": {"type": "array", "items": {"type": "string"}}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

