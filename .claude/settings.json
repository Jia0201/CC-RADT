{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "agent": "lead",
  "minimumVersion": "2.1.140",
  "autoMemoryEnabled": false,
  "includeGitInstructions": false,
  "ai_teams": {
    "version": "1.1.0",
    "hooks_enabled": true,
    "brain_root": ".claude/ai-teams",
    "default_agent_mode": "multi-agent",
    "lead_agent": "lead",
    "initialization_mode": "manual",
    "subagent_runtime": {
      "official_project_dir": ".claude/agents/",
      "component_agent_dir": ".claude/ai-teams/agents/"
    },
    "entrypoints": [
      ".claude/ai-teams/index/ENTRY.md",
      ".claude/ai-teams/rule/index.md",
      ".claude/ai-teams/agents/index.md",
      ".claude/ai-teams/project/index.md",
      ".claude/ai-teams/memory/index.md",
      ".claude/ai-teams/security/index.md",
      ".claude/ai-teams/prompts/index.md",
      ".claude/ai-teams/shared/index.md",
      ".claude/ai-teams/playbook.md"
    ],
    "policy": {
      "initialization": ".claude/ai-teams/security/project-policy.md",
      "security": ".claude/ai-teams/security/index.md",
      "memory": ".claude/ai-teams/memory/index.md",
      "prompts": ".claude/ai-teams/security/prompt-policy.md",
      "multi_agent": ".claude/rules/ai-teams-router.md"
    },
    "memory_governance": {
      "auto_memory_enabled": false,
      "native_claude_memory_policy": "audit-and-ignore",
      "native_claude_memory_audit": ".claude/ai-teams/memory/native-claude-memory-audit.md"
    }
  },
  "permissions": {
    "deny": ["Read(/.env)", "Read(/.env.*)", "Read(/**/.env)", "Read(/**/.env.*)", "Read(/**/.credentials)", "Read(/**/.credentials.*)", "Read(/**/credentials.json)", "Read(/**/credentials.yaml)", "Read(/**/credentials.yml)", "Read(/**/.token)", "Read(/**/.token.*)", "Read(/**/token.json)", "Read(/**/token.yaml)", "Read(/**/token.yml)", "Read(/**/.secret)", "Read(/**/.secret.*)", "Read(/**/secret.json)", "Read(/**/secret.yaml)", "Read(/**/secret.yml)", "Read(/**/secrets/**)", "Read(/**/.secrets/**)", "Read(/**/*.pem)", "Read(/**/*.key)", "Read(/**/*.p12)", "Read(/**/*.pfx)", "Read(/**/id_rsa)", "Read(/**/id_ed25519)", "Read(/**/service-account*.json)", "Bash(rm -rf *)", "Bash(git reset --hard*)", "Bash(git clean -fd*)", "Bash(git push --force*)"]
  },
  "disableAllHooks": false,
  "hooks": {
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command", "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/ai-teams/hooks/scripts/observer-hook.mjs"],
            "timeout": 2
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command", "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/ai-teams/hooks/scripts/ai-teams-run-hook.mjs", "ai-teams-session-start"]
          },
          {
            "type": "command", "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/ai-teams/hooks/scripts/ai-teams-run-hook.mjs", "native-claude-memory-audit"]
          },
          {
            "type": "command", "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/ai-teams/hooks/scripts/observer-hook.mjs"],
            "timeout": 6
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command", "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/ai-teams/hooks/scripts/ai-teams-run-hook.mjs", "ai-teams-user-prompt-submit.sh"]
          },
          {
            "type": "command", "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/ai-teams/hooks/scripts/ai-teams-run-hook.mjs", "git-activity-watch"]
          },
          {
            "type": "command", "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/ai-teams/hooks/scripts/agent-heartbeat.mjs", "reconcile"]
          },
          {
            "type": "command", "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/ai-teams/hooks/scripts/observer-hook.mjs"],
            "timeout": 2
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command", "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/ai-teams/hooks/scripts/observer-hook.mjs"],
            "timeout": 2
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command", "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/ai-teams/hooks/scripts/prompt-contract-check.mjs"]
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob",
        "hooks": [
          {
            "type": "command", "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/ai-teams/hooks/scripts/ai-teams-run-hook.mjs", "sensitive-file-check.sh"]
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command", "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/ai-teams/hooks/scripts/ai-teams-run-hook.mjs", "sensitive-file-check.sh"]
          },
          {
            "type": "command", "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/ai-teams/hooks/scripts/ai-teams-run-hook.mjs", "protected-file-check.sh"]
          },
          {
            "type": "command", "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/ai-teams/hooks/scripts/ai-teams-run-hook.mjs", "protected-file-lock-check.sh"]
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command", "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/ai-teams/hooks/scripts/ai-teams-run-hook.mjs", "delete-check.sh"]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command", "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/ai-teams/hooks/scripts/agent-heartbeat.mjs", "activity"]
          },
          {
            "type": "command", "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/ai-teams/hooks/scripts/observer-hook.mjs"],
            "timeout": 2
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command", "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/ai-teams/hooks/scripts/ai-teams-run-hook.mjs", "index-stale-mark.sh"]
          },
          {
            "type": "command", "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/ai-teams/hooks/scripts/ai-teams-run-hook.mjs", "external-change-check.sh"]
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command", "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/ai-teams/hooks/scripts/agent-heartbeat.mjs", "failure"]
          },
          {
            "type": "command", "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/ai-teams/hooks/scripts/prompt-evolution-event.mjs", "post-tool-failure"]
          },
          {
            "type": "command", "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/ai-teams/hooks/scripts/observer-hook.mjs"],
            "timeout": 2
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command", "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/ai-teams/hooks/scripts/agent-heartbeat.mjs", "failure"]
          },
          {
            "type": "command", "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/ai-teams/hooks/scripts/prompt-evolution-event.mjs", "permission-denied"]
          },
          {
            "type": "command", "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/ai-teams/hooks/scripts/observer-hook.mjs"],
            "timeout": 2
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command", "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/ai-teams/hooks/scripts/agent-heartbeat.mjs", "start"]
          },
          {
            "type": "command", "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/ai-teams/hooks/scripts/observer-hook.mjs"],
            "timeout": 2
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command", "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/ai-teams/hooks/scripts/agent-heartbeat.mjs", "stop"]
          },
          {
            "type": "command", "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/ai-teams/hooks/scripts/prompt-evolution-event.mjs", "subagent-stop"]
          },
          {
            "type": "command", "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/ai-teams/hooks/scripts/observer-hook.mjs"],
            "timeout": 2
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command", "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/ai-teams/hooks/scripts/agent-heartbeat.mjs", "stop"]
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command", "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/ai-teams/hooks/scripts/agent-heartbeat.mjs", "stop"]
          },
          {
            "type": "command", "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/ai-teams/hooks/scripts/prompt-evolution-event.mjs", "task-completed"]
          },
          {
            "type": "command", "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/ai-teams/hooks/scripts/observer-hook.mjs"],
            "timeout": 2
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command", "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/ai-teams/hooks/scripts/ai-teams-run-hook.mjs", "context-compression-check.sh"]
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command", "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/ai-teams/hooks/scripts/ai-teams-run-hook.mjs", "context-compression-check.sh"]
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command", "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/ai-teams/hooks/scripts/agent-heartbeat.mjs", "failure"]
          },
          {
            "type": "command", "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/ai-teams/hooks/scripts/prompt-evolution-event.mjs", "stop-failure"]
          },
          {
            "type": "command", "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/ai-teams/hooks/scripts/observer-hook.mjs"],
            "timeout": 2
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command", "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/ai-teams/hooks/scripts/ai-teams-run-hook.mjs", "context-compression-check.sh"]
          },
          {
            "type": "command", "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/ai-teams/hooks/scripts/ai-teams-run-hook.mjs", "lock-timeout-check.sh"]
          },
          {
            "type": "command", "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/ai-teams/hooks/scripts/ai-teams-run-hook.mjs", "git-activity-watch"]
          },
          {
            "type": "command", "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/ai-teams/hooks/scripts/agent-heartbeat.mjs", "reconcile"]
          },
          {
            "type": "command", "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/ai-teams/hooks/scripts/observer-hook.mjs"],
            "timeout": 2
          }
        ]
      }
    ]
  }
}
