{
  "version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "scope", "owner", "status", "trigger"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "enum": ["agents", "project", "security"]
    },
    "owner": {
      "type": "string",
      "enum": [
        "lead",
        "pd",
        "plan-pm",
        "dev-frontend-web",
        "dev-frontend-miniapp",
        "dev-backend-systems",
        "dev-backend-service",
        "qa",
        "memory",
        "doc",
        "role",
        "security-reviewer"
      ]
    },
    "status": {
      "type": "string",
      "enum": ["draft", "active", "deprecated"]
    },
    "trigger": {
      "type": "string",
      "minLength": 1
    },
    "read_order": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "write_scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "forbidden": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validation": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
